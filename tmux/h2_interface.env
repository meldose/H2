# Config for tmux/h2_state_viewer_real.tmuxp.yaml and
# tmux/h2_rviz_live_real.tmuxp.yaml — edit and reload the session, no need
# to touch the tmuxp files or retype it on the command line.

# Host network interface connected to H2 over Ethernet — run `ip a` after
# plugging in the cable to find it. This is just the NIC name, not an IP;
# the host's own static IP (192.168.123.99/24) is a separate one-time step,
# see docs/RUNBOOK.md § Real robot.
H2_INTERFACE=eth0
